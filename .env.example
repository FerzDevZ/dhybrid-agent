# Copy ke .env dan isi key yang kamu punya (semua opsional — isi yang ada)
# Model default (opencode zen free) jalan TANPA key — cuma butuh key kalau mau model premium

# Premium providers (butuh key untuk tool calling agentic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
BYNARA_API_KEY=

# OpenCode Zen — model free jalan TANPA key, tapi support tool calling butuh key valid
# Daftar model free: nemotron-3-ultra-free, deepseek-v4-flash-free, laguna-s-2.1-free, dll.
# Jika key kosong → model jalan tapi HANYA chatbot (tidak support tool calling/agentic)
OPENCODE_ZEN_API_KEY=